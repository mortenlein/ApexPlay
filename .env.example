# Template only — copy to .env (git-ignored) and fill with REAL values.
# Never put real deployment values in this file.

# Public origin the app runs on. Drives the Steam realm/return_to URL.
NEXTAUTH_URL=http://192.168.3.20:4001

# Long random string that signs session cookies. Rotating it logs everyone out.
#   openssl rand -hex 32
NEXTAUTH_SECRET=change-me

# Comma-separated steamid64 allowlist that resolves to admin/organizer at login.
# Find your steamid64 at https://steamid.io. Admin is an identity, not a password.
ADMIN_STEAMIDS=76561198000000001

# Optional: comma-separated steamid64 allowlist for floor staff (marshals). Marshals can
# reach /marshal and run match flow but are not full organizers.
MARSHAL_STEAMIDS=

# Steam Web API key — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Bearer key inbound CS2 / EON (GSI) score updates must send. The webhook fails closed if
# unset, so set this before pointing a live source at /api/webhooks/cs2.
CS2_WEBHOOK_KEY=

# SQLite path (Docker sets this automatically to the mounted volume).
DATABASE_URL=file:./dev.db

# Web push (player "your match is up" alerts). Generate a keypair with:
#   npx web-push generate-vapid-keys
# Leave blank to disable web push (the Enable-alerts button hides itself).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@apexplay.local

# --- Local dev only ------------------------------------------------------------
# Enable mock persona login buttons on /login (server side):
# MOCK_AUTH_MODE=true
# Show the mock persona buttons in the browser:
# NEXT_PUBLIC_MOCK_AUTH=true

# Optional integrations
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Announcements (match ready / results / signups / "bracket is live"). Set EITHER a channel
# webhook URL, OR a bot token + channel id. If neither is set (or NEXT_PUBLIC_STRATEGY_3_MOCK=true),
# announcements are only written to the in-app notification log.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=
# For the optional slash-command bot (npm run bot):
# DISCORD_GUILD_ID=
